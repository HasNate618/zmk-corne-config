#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
	behaviors {
		emdash: emdash {
			compatible = "zmk,behavior-macro";
			label = "EMDASH";
			#binding-cells = <0>;
			wait-ms = <40>;
			bindings = <&macro_tap &kp PAUSE &kp MINUS &kp MINUS &kp MINUS>;   // pause=compose, --- → —
		};
		rightarrow: rightarrow {
			compatible = "zmk,behavior-macro";
			label = "RIGHTARROW";
			#binding-cells = <0>;
			wait-ms = <40>;
			bindings = <&macro_tap &kp PAUSE &kp MINUS &kp LS(DOT)>;   // pause=compose, -> → →
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			bindings = <
				&kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I &kp O &kp P    &kp BSPC
				&mt LCTRL ESC &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
				&kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp BSLH
				        &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
			>;
		};

		lower_layer {
			display-name = "Lower";
			bindings = <
				&kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5) &kp LS(N6)   &trans &kp N7 &kp N8 &kp N9 &kp MINUS &kp PLUS
				&mt LCTRL LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp LS(MINUS) &kp LS(EQUAL)   &trans &kp N4 &kp N5 &kp N6 &kp UNDERSCORE &kp EQUAL
				&kp GRAVE &kp TILDE &kp LBKT &kp RBKT &kp LBRC &kp RBRC   &kp N0 &kp N1 &kp N2 &kp N3 &emdash &rightarrow
				        &trans &trans &trans   &trans &mo 3 &trans
			>;
		};

		raise_layer {
			display-name = "Raise";
			bindings = <
				&kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12   &kp HOME &kp END &kp PG_UP &kp PG_DN &kp INS &kp DEL
				&mt LCTRL F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp C_BRI_INC &kp VOLU
				&trans &trans &trans &trans &trans &trans   &kp C_MUTE &kp C_PREV &kp C_NEXT &kp C_PLAY_PAUSE &kp C_BRI_DEC &kp VOLD
				        &trans &mo 3 &trans   &trans &trans &trans
			>;
		};

		mouse_layer {
			display-name = "Mouse";
			bindings = <
				&trans &trans &trans &trans &trans &trans   &mkp LCLK &mkp RCLK &msc SCRL_UP &msc SCRL_DOWN &trans &bt BT_CLR_ALL   // BSPC=clear all BT bonds
				&trans &trans &trans &trans &trans &trans   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans &trans
				&mkp MB4 &mkp MB5 &trans &trans &trans &trans   &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans &soft_off   // M=laptop(0), ,=phone(1), .=tablet(2), \=soft off
				        &trans &trans &trans   &trans &trans &trans
			>;
		};
	};
};
